{
  "name": "pingel-bold",
  "extends": "pingel-brand",
  "glow": { "enabled": false, "depthHook": false },
  "captions": { "animation": "cut", "uppercase": false, "autoKeywords": false, "annotate": false, "activeWord": false },
  "hook": { "push": false, "behind": false },
  "graphics": { "enabled": false, "persistent": false, "ladder": false },
  "slams": { "enabled": false, "popout": { "enabled": false } },
  "icons": { "enabled": false },
  "coldOpen": { "enabled": false },
  "houseLooks": { "enabled": false },
  "broll": { "enabled": false },
  "premise": { "mode": "off" },
  "timeLabels": { "enabled": false },
  "signature": { "enabled": false },
  "motion": { "impact": { "enabled": false }, "drift": { "enabled": false } },
  "zooms": { "enabled": true, "style": "snap", "onKey": false, "minSpacing": 7.5, "maxPer30": 4, "snap": 0, "cadence": { "enabled": false } },
  "bold": {
    "enabled": true,
    "schemaVersion": 1,
    "colors": { "black": "#0B0B0D", "gold": "#C8A24B", "bone": "#F5F1E8" },
    "headline": { "minWords": 4, "maxWords": 8, "hold": 3, "longHold": 4.5, "longWords": 7, "size": 84, "weight": 900, "font": "Inter", "lineHeight": 1.08, "padding": 20, "opacity": 0.94 },
    "phrases": { "targetWords": 3, "minWords": 2, "maxWords": 4, "protectedMaxWords": 7, "targetSeconds": 0.75, "minSeconds": 0.4, "maxSeconds": 1.8, "lead": 0.05, "maxGap": 0.7, "goldShare": 0.25, "punchShare": 0.4, "protectedPhrases": [] },
    "quiet": { "size": 84, "weight": 650, "emphasisWeight": 900, "lineHeight": 1.08, "stroke": 6, "shadow": "0 3px 8px rgba(0,0,0,0.85), 0 5px 22px rgba(0,0,0,0.65)" },
    "punch": { "size": 104, "weight": 900, "lineHeight": 1.02, "stroke": 12, "payoffScale": 1.9, "payoffFrames": 4, "payoffFrom": 0.96, "payoffSettle": false },
    "zone": { "left": 76, "right": 1004, "top": 200, "bottom": 1600, "captionTop": 1056, "chinGap": 32, "overlayGap": 32, "headMargin": 0.15 },
    "faces": { "samplesPerSecond": 4 },
    "framing": { "enabled": true, "maxPer30": 4, "minSpacing": 7.5 },
    "proof": { "enabled": true, "manifest": "~/Reels/brand-assets/proof/manifest.json", "max": 2, "width": 820, "height": 360, "soundVolume": 0.12 },
    "define": { "enabled": true, "max": 2, "width": 820, "maxWords": 14, "soundVolume": 0.12 },
    "math": { "enabled": true, "max": 2, "widthFraction": 0.4, "size": 96, "resultSound": false, "soundVolume": 0.1 },
    "talk": { "enabled": true, "gregPerson": null, "otherWeight": 600, "topic": { "enabled": true, "minWords": 4, "maxWords": 7, "width": 720, "size": 44, "padding": 16 } },
    "sticker": { "enabled": true, "photosDir": "~/automation/ig-content/photos", "iconsDir": "~/Reels/brand-assets/icons3d", "width": 260, "hold": 1.2, "maxPerReel": 2, "minSpacing": 10, "maxReaction": 1, "photoLimit": 24 },
    "payoff": { "enabled": true, "width": 320, "hold": 1, "style": "stack", "pieces": 9 }
  }
}
