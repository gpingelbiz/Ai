{
  "name": "pingel-brand",
  "brandFile": "brands/pingel.json",
  "canvas": "auto",
  "colors": {
    "text": "#F5F1E8",
    "accent": "#C8A24B",
    "stroke": "#000000",
    "bg": "#0B0B0D"
  },
  "transcribe": {
    "verify": true
  },
  "captions": {
    "enabled": true,
    "wordsPerLine": 3,
    "position": 0.65,
    "fontSizeFrac": 0.04,
    "uppercase": true,
    "animation": "pop",
    "style": "reveal",
    "activeWord": false,
    "emojis": false,
    "autoKeywords": true,
    "annotate": true,
    "maxKeywordsPerLine": 1,
    "placeMin": 0.58,
    "placeMax": 0.79,
    "placeGap": 0.025,
    "minShow": 0.35
  },
  "hook": {
    "enabled": true,
    "duration": 3,
    "position": 0.22,
    "fontSizeFrac": 0.041,
    "maxWords": 8,
    "autoPlace": true,
    "style": "headline",
    "behind": false,
    "plaque": true
  },
  "zooms": {
    "enabled": true,
    "onKey": true,
    "minSpacing": 6,
    "maxPer30": 4,
    "interval": 5,
    "scales": [
      1.14,
      1.22
    ],
    "origin": "50% 38%",
    "snap": 0.12,
    "style": "camera",
    "cadence": {
      "enabled": false
    }
  },
  "cuts": {
    "silence": "medium",
    "badTakes": true,
    "fillers": true,
    "pad": 0.12
  },
  "audio": {
    "music": null,
    "cleanAudio": true,
    "sfx": false,
    "sounds": true
  },
  "cta": {
    "enabled": false,
    "last": 3,
    "position": 0.48,
    "style": "pill",
    "fontSizeFrac": 0.036
  },
  "graphics": {
    "enabled": true,
    "max": 3,
    "every": 15,
    "clearStart": 5
  },
  "broll": {
    "style": "",
    "world": "Greg Pingel sells and coaches sales: a sales floor with closers on the phone, call reports and numbers on a screen, a whiteboard with one number, a manager at a desk after a bad month, text threads with reps, a truck tailgate and a garage, an office with neon signs, eight years in the military, a Bible on a passenger seat. Working-class, Texas, lived-in, no glamour.",
    "layout": "full-split",
    "clearStart": 5,
    "max": 5,
    "every": 10,
    "duration": 2.5,
    "gap": 3,
    "maxWithGraphics": 2,
    "videoSeconds": 3,
    "maxCreditsPerReel": 300,
    "hardCreditsPerReel": 450,
    "retrySameModelFirst": true,
    "rapidLists": true,
    "grade": false,
    "retryVideoModel": "kling3.0_standard",
    "focusPull": 0,
    "imageModel": "nano_banana_2.1",
    "videoModel": "gen4.5",
    "actionVideoModel": "gen4.5",
    "lastFrame": false,
    "sfx": true,
    "sfxUnderSpeechDb": 12,
    "stock": ["pexels", "pixabay", "wikimedia"],
    "library": true,
    "animate": false
  },
  "carousel": {
    "handle": "@officialgregpingel",
    "style": "moody low-key light, deep blacks, warm gold and amber highlights, muted colors, a little film grain; no neon, no purple, no pastel"
  },
  "slams": {
    "enabled": true,
    "popout": {
      "enabled": true,
      "max": 1,
      "minRank": 0
    },
    "color": "ink"
  },
  "coldOpen": {
    "enabled": false
  },
  "icons": {
    "enabled": true
  },
  "motion": {
    "impact": {
      "enabled": true
    },
    "drift": {
      "enabled": true
    }
  },
  "looks": {
    "lockHook": true,
    "lockCaptions": true,
    "lockBrollGrade": true
  },
  "cover": {
    "style": "archetypes"
  },
  "finish": {
    "enabled": true
  },
  "glow": {
    "enabled": true
  }
}
