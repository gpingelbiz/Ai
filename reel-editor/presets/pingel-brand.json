{
  "name": "pingel-brand",
  "canvas": "auto",
  "colors": {
    "text": "#F5F1E8",
    "accent": "#C8A24B",
    "stroke": "#000000",
    "bg": "#0B0B0D"
  },
  "transcribe": {
    "verify": true
  },
  "captions": {
    "enabled": true,
    "wordsPerLine": 3,
    "position": 0.6,
    "fontSizeFrac": 0.04,
    "uppercase": true,
    "animation": "pop",
    "style": "reveal",
    "activeWord": false,
    "emojis": false,
    "autoKeywords": true,
    "annotate": true
  },
  "hook": {
    "enabled": true,
    "duration": 3,
    "position": 0.22,
    "fontSizeFrac": 0.052,
    "maxWords": 8,
    "autoPlace": true,
    "style": "headline"
  },
  "zooms": {
    "enabled": true,
    "interval": 5,
    "scales": [
      1.14,
      1.22
    ],
    "origin": "50% 38%",
    "snap": 0.12,
    "style": "camera"
  },
  "cuts": {
    "silence": "fast",
    "badTakes": true,
    "fillers": true,
    "pad": 0.12
  },
  "audio": {
    "music": null,
    "cleanAudio": true,
    "sfx": false
  },
  "cta": {
    "enabled": false,
    "last": 3,
    "position": 0.48,
    "style": "pill",
    "fontSizeFrac": 0.036
  },
  "graphics": {
    "enabled": true
  },
  "broll": {
    "style": ""
  },
  "carousel": {
    "handle": "@officialgregpingel",
    "style": "moody low-key light, deep blacks, warm gold and amber highlights, muted colors, a little film grain; no neon, no purple, no pastel"
  },
  "slams": {
    "enabled": true
  }
}
