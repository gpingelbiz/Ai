{
  "name": "pingel-brand",
  "brandFile": "brands/pingel.json",
  "canvas": "auto",
  "colors": {
    "text": "#F5F1E8",
    "accent": "#C8A24B",
    "stroke": "#000000",
    "bg": "#0B0B0D"
  },
  "transcribe": {
    "verify": true
  },
  "captions": {
    "enabled": true,
    "wordsPerLine": 3,
    "position": 0.65,
    "fontSizeFrac": 0.0355,
    "uppercase": false,
    "animation": "cut",
    "style": "reveal",
    "activeWord": false,
    "emojis": false,
    "autoKeywords": false,
    "annotate": false,
    "placeMin": 0.58,
    "placeMax": 0.72,
    "placeGap": 0.025,
    "dimFuture": false,
    "keywordColorOnFootage": false
  },
  "hook": {
    "enabled": true,
    "duration": 3,
    "position": 0.22,
    "fontSizeFrac": 0.041,
    "maxWords": 12,
    "autoPlace": true,
    "style": "headline",
    "behind": false,
    "plaque": true
  },
  "zooms": {
    "enabled": true,
    "interval": 5,
    "scales": [
      1.14,
      1.22
    ],
    "origin": "50% 38%",
    "snap": 0.12,
    "style": "camera",
    "cadence": {
      "enabled": true
    }
  },
  "cuts": {
    "silence": "fast",
    "badTakes": true,
    "fillers": true,
    "pad": 0.12
  },
  "audio": {
    "music": null,
    "cleanAudio": true,
    "sfx": false,
    "sounds": true
  },
  "cta": {
    "enabled": false,
    "last": 3,
    "position": 0.48,
    "style": "pill",
    "fontSizeFrac": 0.036
  },
  "graphics": {
    "enabled": true
  },
  "broll": {
    "style": "",
    "world": "Greg Pingel sells and coaches sales: a sales floor with closers on the phone, call reports and numbers on a screen, a whiteboard with one number, a manager at a desk after a bad month, text threads with reps, a truck tailgate and a garage, an office with neon signs, eight years in the military, a wife and kids at home, a Bible on a passenger seat. Working-class, Texas, lived-in, no glamour.",
    "layout": "full-split"
  },
  "carousel": {
    "handle": "@officialgregpingel",
    "style": "moody low-key light, deep blacks, warm gold and amber highlights, muted colors, a little film grain; no neon, no purple, no pastel"
  },
  "slams": {
    "enabled": true,
    "popout": {
      "enabled": true,
      "max": 1,
      "minRank": 0
    },
    "color": "ink"
  },
  "coldOpen": {
    "enabled": false
  },
  "icons": {
    "enabled": true
  },
  "motion": {
    "impact": {
      "enabled": true
    },
    "drift": {
      "enabled": true
    }
  },
  "looks": {
    "lockHook": true,
    "lockCaptions": true
  },
  "cover": {
    "style": "archetypes"
  },
  "finish": {
    "enabled": true
  }
}
