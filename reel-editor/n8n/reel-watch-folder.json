{
  "name": "Reel editor: watch folder",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "/Users/gregpingel/Reels/raw",
        "events": ["add"],
        "options": {
          "awaitWriteFinish": true,
          "usePolling": true,
          "ignored": "**/.*"
        }
      },
      "id": "1f1c2b1e-0001-4a00-8000-000000000001",
      "name": "New file in ~/Reels/raw",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.path }}",
              "rightValue": "\\.(mov|mp4|m4v|webm|mkv)$",
              "operator": { "type": "string", "operation": "regex" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f1c2b1e-0002-4a00-8000-000000000002",
      "name": "Is a video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "command": "=/Users/gregpingel/Ai/reel-editor/scripts/watch-reel.sh \"{{ $json.path }}\""
      },
      "id": "1f1c2b1e-0003-4a00-8000-000000000003",
      "name": "reel edit",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, -80],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nlet result = { ok: false };\ntry { result = JSON.parse((r.stdout || '').trim().split('\\n').pop() || '{}'); } catch {}\nconst text = result.ok\n  ? `Reel ready: ${result.output}` + (result.hook ? `\\nHook: ${result.hook}` : '')\n  : `Reel FAILED for ${result.input || 'unknown file'}. Log: ${result.log || '~/Reels/watch.log'}\\n${(r.stderr || '').slice(-800)}`;\nreturn [{ json: { ...result, text, exitCode: r.exitCode } }];"
      },
      "id": "1f1c2b1e-0004-4a00-8000-000000000004",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -80]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "mode": "id", "value": "C0C7Z7L5GBZ" },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "1f1c2b1e-0005-4a00-8000-000000000005",
      "name": "Post to #pingel-hq",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [960, -80],
      "disabled": true
    },
    {
      "parameters": {
        "command": "=osascript -e 'display notification \"{{ $json.text.replace(/\"/g, '') }}\" with title \"Reel editor\"'"
      },
      "id": "1f1c2b1e-0006-4a00-8000-000000000006",
      "name": "Mac notification",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [960, 80]
    }
  ],
  "connections": {
    "New file in ~/Reels/raw": { "main": [[{ "node": "Is a video?", "type": "main", "index": 0 }]] },
    "Is a video?": { "main": [[{ "node": "reel edit", "type": "main", "index": 0 }], []] },
    "reel edit": { "main": [[{ "node": "Parse result", "type": "main", "index": 0 }]] },
    "Parse result": {
      "main": [[
        { "node": "Post to #pingel-hq", "type": "main", "index": 0 },
        { "node": "Mac notification", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": { "executionOrder": "v1", "executionTimeout": 1800 },
  "active": false
}
