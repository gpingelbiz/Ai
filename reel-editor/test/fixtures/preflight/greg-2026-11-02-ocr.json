[
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"YOU DON'T HAVE A CLOSER PROBLEM.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"You have a volume problem wearing a closer costume.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"SIX CALLS A WEEK.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"Picture a commission-only closer with six calls on his calendar. He can't feed his family on that.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"THE GOOD ONES SAY NO.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"A closer who can sell does the math before he takes the seat. Six calls a week doesn't pay his mortgage, so he walks.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"SO WHO SAYS YES?","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"The ones nobody else would hire. You didn't hire wrong. Your volume picked him.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"DO THE MATH FIRST.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"About 15 qualified calls a week. A 20% close rate. A $3,000 ticket. Below that, a closer makes the business worse.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"BELOW IT? YOU CLOSE.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"Keep taking the calls yourself. Put the money into getting to fifteen a week. Hire when the math can feed a closer.","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]},
  {"width":1080,"height":1350,"faces":[],"lines":[{"text":"VOLUME FIRST. THEN THE CLOSER.","confidence":0.99,"box":{"x":0.1,"y":0.1,"w":0.8,"h":0.1}},{"text":"Count last week's qualified calls. One word: ABOVE or BELOW?","confidence":0.99,"box":{"x":0.1,"y":0.4,"w":0.8,"h":0.08}},{"text":"@officialgregpingel","confidence":0.99,"box":{"x":0.1,"y":0.92,"w":0.4,"h":0.03}}]}
]
